{
  "name": "mcprepo",
  "version": "0.1.0",
  "private": true,
  "description": "A secure local MCP server for tracking personal expenses in CSV.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc",
    "check:schema": "tsx scripts/check-schema.ts",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "typescript",
    "expenses"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0-beta.5",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.2",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
